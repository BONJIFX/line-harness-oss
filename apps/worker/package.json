{
  "name": "worker",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:deps": "pnpm --filter @line-crm/line-sdk build && pnpm --filter @line-crm/shared build",
    "dev": "vite dev",
    "prebuild": "pnpm run build:deps",
    "build": "vite build",
    "preview": "vite preview",
    "pretest": "pnpm run build:deps",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "@line-crm/db": "workspace:*",
    "@line-crm/line-sdk": "workspace:*",
    "@line-crm/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^4.20241205.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0",
    "wrangler": "^4.0.0"
  }
}
